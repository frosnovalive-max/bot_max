# ============================================================
# ТОКЕН БОТА MAX (получить в панели разработчика MAX)
# Без этого токена бот НЕ ЗАПУСТИТСЯ (fail-fast)
# ============================================================
MAX_BOT_TOKEN=your_max_bot_token_here

# ============================================================
# MAX API — куда БОТ отправляет запросы (сообщения, профили)
# ВНИМАНИЕ: это НЕ адрес вебхука! Это адрес API MAX.
# Уточните актуальный URL в https://dev.max.ru/docs
# ⚠️ НЕ добавляйте этот путь в BOT_BASE_URL!
# ============================================================
MAX_API_URL=https://api.max.ru/v3

# ============================================================
# CORE API — адрес нашего бэкенда (бизнес-логика тикетов)
# ⚠️ ВНУТРИ DOCKER: используйте имя сервиса из docker-compose.yml
# НЕ используйте localhost или 127.0.0.1!
# Для локальной разработки без Docker: http://localhost:8000/api/v1
# Для Docker: http://it_support_api:8000/api/v1
# ============================================================
API_URL=http://it_support_api:8000/api/v1

# API-ключ для авторизации бота в Core API (заголовок X-API-Key)
API_KEY=your_internal_api_key_here

# ============================================================
# ВЕБХУК — куда MAX отправляет уведомления о новых сообщениях
# BOT_BASE_URL = публичный URL вашего сервера (без слэша на конце!)
# WEBHOOK_PATH = путь в вашем FastAPI-приложении
# Итоговый URL для регистрации в панели MAX / caddy-туннеле:
#   https://your-domain.trycloudflare.com/webhook/max
# ⚠️ НЕ добавляйте /v3 в BOT_BASE_URL — это путь MAX API, не ваш
# ============================================================
BOT_BASE_URL=https://your-tunnel-url.trycloudflare.com
WEBHOOK_PATH=/webhook/max

# Порт, который слушает uvicorn внутри контейнера
BOT_PORT=8080

# Секретная строка для проверки входящих вебхуков от MAX
# (MAX подписывает каждый вебхук заголовком X-Webhook-Secret)
MAX_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================
# REDIS — для хранения FSM-состояний многошаговых диалогов
# ⚠️ ВНУТРИ DOCKER: используйте имя сервиса (max_bot_redis)
# Если Redis недоступен, бот автоматически переключится на
# MemoryStorage (состояния теряются при перезапуске)
# ============================================================
REDIS_URL=redis://max_bot_redis:6379/0

# ============================================================
# ЛОГИРОВАНИЕ
# ============================================================
LOG_LEVEL=INFO
